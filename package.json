{
  "name": "SlackSmith",
  "version": "0.1.0",
  "description": "Build a Slack bot with no code",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:standalone && npm run build:preload && npm run build:renderer",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:standalone": "node scripts/bundle-standalone-runner.mjs",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "tsc -p tsconfig.renderer.json && node -e \"const fs=require('fs');const path=require('path');const out='dist/renderer';fs.mkdirSync(out,{recursive:true});fs.mkdirSync(path.join(out,'design'),{recursive:true});fs.mkdirSync(path.join(out,'components'),{recursive:true});fs.copyFileSync('src/renderer/index.html',path.join(out,'index.html'));fs.copyFileSync('src/renderer/styles.css',path.join(out,'styles.css'));fs.copyFileSync('src/renderer/design/tokens.css',path.join(out,'design/tokens.css'));fs.copyFileSync('src/renderer/components/components.css',path.join(out,'components/components.css'));\"",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "typecheck": "npm run typecheck:main && npm run typecheck:preload && npm run typecheck:renderer",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:preload": "tsc -p tsconfig.preload.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@slack/bolt": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "electron": "^43.3.0",
    "esbuild": "^0.25.9",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "prettier": "^3.9.6"
  }
}
